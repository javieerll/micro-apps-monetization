# Copia estos nombres a Vercel → Settings → Environment Variables.
# No subas un .env con claves de verdad.

# Frase larga inventada por ti. Firma el pase de pago y el contador diario.
# Sin esto, el límite gratis solo vive en el navegador y se puede saltar.
APP_SECRET=

# Opcional. Si la dejas vacía, se usa la URL desde la que entra la gente.
# Ejemplo: https://hookgen.vercel.app
PUBLIC_URL=

# Una de las dos claves de IA. Groq tiene capa gratuita.
# Si no pones ninguna, HookGen responde con textos de reserva y no gasta dinero.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Stripe, modo prueba al principio (sk_test_...).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Opcional. Hace falta para el paquete de 50 créditos.
# El pase de 7 y de 30 días funciona sin esto.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
