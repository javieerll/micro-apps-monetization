# Nombres exactos para Vercel → Settings → Environment Variables.

# Frase larga tuya. Sin ella, el límite de 3 facturas solo vive en el navegador.
APP_SECRET=

# Ejemplo: https://facturapro.vercel.app
PUBLIC_URL=

# Empieza por sk_test_ mientras pruebas.
STRIPE_SECRET_KEY=

# Opcional. Hace el límite más difícil de saltar.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
