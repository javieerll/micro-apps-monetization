# Copia este archivo a .env solo si pruebas con `vercel dev`.
# En producción, pega las mismas claves en Vercel → Settings → Environment Variables.
# No subas el .env a GitHub.

# Token que te da @BotFather al crear el bot. Empieza por un número y dos puntos.
TELEGRAM_BOT_TOKEN=

# URL pública de la mini app, sin barra final.
# Ejemplo: https://streakmaster.vercel.app
WEBAPP_URL=

# Una frase larga inventada por ti. La misma que usarás al registrar el webhook.
# Sirve para que nadie que descubra la URL pueda fingir ser Telegram.
TELEGRAM_WEBHOOK_SECRET=
